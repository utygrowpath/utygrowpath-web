# Salin file ini menjadi .env.local untuk pengembangan lokal:
#   cp .env.example .env.local
#
# JANGAN commit .env.local atau file .env* lain — sudah di-.gitignore.
# Nilai asli disimpan di Vercel (Settings -> Environment Variables).
#
# Saat ini website belum membutuhkan variable apa pun (semua halaman statis).
# Variable di bawah akan dipakai saat form pendaftaran + database dikerjakan.
# Lihat docs/adr/0004-form-pendaftaran-server-action-database.md

# Koneksi database (Postgres)
# DATABASE_URL="postgres://user:password@host:5432/dbname"

# Daftar email panitia yang boleh mengakses halaman admin (pisahkan dengan koma)
# ADMIN_ALLOWED_EMAILS="ketua@example.com,web@example.com"

# Proteksi spam formulir (Cloudflare Turnstile) — opsional
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
