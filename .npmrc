# Gagalkan install bila versi Node/npm tidak sesuai "engines" di package.json,
# supaya resolusi dependency (termasuk peer dependency ESLint) identik di semua mesin & CI.
engine-strict=true

# Jangan pernah dipakai di proyek ini: menyembunyikan konflik peer dependency
# dan membuat hasil install bergantung pada mesin masing-masing.
# legacy-peer-deps=false
